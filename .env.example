# Anthropic API key used server-side only by the platform copilot chatbot.
# Never exposed to the client.
ANTHROPIC_API_KEY=

# Shared password gate for the whole app (not per-user accounts).
SITE_PASSWORD=

# Random long string used to sign the auth cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Anthropic model used by the chatbot.
CHAT_MODEL=claude-sonnet-5

# Max tokens per chatbot response.
CHAT_MAX_TOKENS=1024

NODE_ENV=production

# PORT is injected automatically by Railway. Do not set it locally unless
# you are specifically testing the production build.

# Optional. When both are set, the "New service" wizard's real-creation
# mode becomes available: it will actually create repos on GitHub under
# this account. Leave unset to keep the wizard fully simulated.
# GITHUB_PAT must be a classic Personal Access Token with the "repo" scope.
GITHUB_PAT=
GITHUB_OWNER=
